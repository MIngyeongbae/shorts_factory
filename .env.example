# .env의 키 목록. 이 파일만 커밋된다 (.gitignore의 !.env.example 예외).
# 값은 절대 적지 않는다. `.env`를 만들어 실제 값을 넣는다.

# [3] tts+sync — ElevenLabs (ADR-0004)
# 대시보드에서 발급. **`sk_`로 시작하는 값**이며 생성·회전 시점에만 보인다.
# 키 ID(하이픈 없는 64자 hex)는 인증에 쓸 수 없다.
ELEVENLABS_API_KEY=sk_...

# 클로닝한 본인 목소리의 voice_id (ADR-0004).
# 대시보드에서 클로닝한 뒤 채운다. 비어 있으면 [3]이 진입 전에 멈춘다.
ELEVEN_VOICE_ID=

# [6] imagegen · [7] motion — Midjourney 정액 + 로컬 프록시 (ADR-0025·0039).
# 프록시가 로컬 기본값(127.0.0.1:8086 / admin)이면 둘 다 생략해도 된다.
# MJ_API_SECRET은 프록시의 mj-api-secret 설정과 같아야 한다.
MJ_PROXY_URL=
MJ_API_SECRET=

# [6] imagegen 폴백 방언 — Nano Banana 2 = Gemini 이미지 모델
# (ADR-0005·0021. ADR-0025가 주 경로를 MJ로 옮기며 폴백으로 남았다.)
# Google AI Studio의 **유료** 키. 무료 키로는 이미지 생성이 막힌다.
# 모델 ID는 gemini-3.1-flash-image.
GEMINI_API_KEY=AIza...

# [7] motion 차선 — Kling i2v (ADR-0025 §3, MJ 밴 대비).
# 주 경로는 MJ 영상 relax다 (ADR-0039). kling 호출 경로는 미구현.
KLING_API_KEY=
