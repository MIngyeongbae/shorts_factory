# .env의 키 목록. 이 파일만 커밋된다 (.gitignore의 !.env.example 예외).
# 값은 절대 적지 않는다. `.env`를 만들어 실제 값을 넣는다.

# [3] tts+sync — 엔진은 `run.py tts --provider`가 고른다. **기본은 typecast** (ADR-0081).
# 두 벤더의 voice_id는 서로 다른 네임스페이스라 변수를 공유하지 않는다.
# 쓸 제공자의 키와 **그 언어의 voice_id**가 비어 있으면 [3]은 호출 전에 멈춘다 (과금 없음).

# --- 타입캐스트 (기본) ---
# studio.typecast.ai/developers/api 에서 발급.
TYPECAST_API_KEY=
# 언어별 목소리. 내장 목소리는 `tc_`, 인스턴트 클론은 `uc_`로 시작한다 (소문자).
# 목록: studio.typecast.ai/developers/api/voices
TYPECAST_VOICE_ID_KO=
TYPECAST_VOICE_ID_JA=
TYPECAST_VOICE_ID_EN=
# 옛 이름 — 비어 있으면 ko가 여기로 떨어진다. 새로 적을 때는 위의 _KO를 쓴다.
TYPECAST_VOICE_ID=

# --- ElevenLabs (대안: --provider elevenlabs) ---
# 대시보드에서 발급. **`sk_`로 시작하는 값**이며 생성·회전 시점에만 보인다.
# 키 ID(하이픈 없는 64자 hex)는 인증에 쓸 수 없다.
ELEVENLABS_API_KEY=sk_...

# 언어별 목소리 (ADR-0056). 플랜이 payg로 내려간 뒤로 ko도 보이스 라이브러리 id다
# (ADR-0004 개정, 2026-08-21).
ELEVEN_VOICE_ID_KO=
ELEVEN_VOICE_ID_JA=
ELEVEN_VOICE_ID_EN=
# 옛 이름 (ADR-0004) — 비어 있으면 ko가 여기로 떨어진다.
ELEVEN_VOICE_ID=

# 휴면 MJ 이미지 어댑터용 자리 (ADR-0056 결정 1 — 어느 단계도 부르지 않는다).
# 프록시가 로컬 기본값(127.0.0.1:8086 / admin)이면 둘 다 생략해도 된다.
MJ_PROXY_URL=
MJ_API_SECRET=

# [7] videogen — 어댑터는 사람이 judgment/human.json `video_line`에 고른 영상 라인이 정한다 (ADR-0059).
#
# 로컬 라인 (기본, 변동비 0): ComfyUI Desktop + MiniMax H3. 같은 PC의 API 주소와 렌더 메가픽셀.
# COMFY_H3_MEGAPIXELS를 비우면 템플릿(config/comfy/h3-t2v.api.json)의 0.4 — 첫 실편을 폰에서 본 뒤
# 사람이 정한다 (ADR-0059 결정 7). 1.0이면 768×1376, 클립당 12~16분.
COMFY_URL=http://127.0.0.1:8188
COMFY_H3_MEGAPIXELS=
#
# 유료 API 라인: Gemini Omni Flash 텍스트→영상, Google Gemini API 직접 (ADR-0056 결정 2).
# Google AI Studio의 **유료** 키. 영상 생성은 종량(≈$0.10/s)이라 토픽당 ≈$8이 나간다 (ADR-0057).
# 모델 ID는 gemini-omni-flash-preview (OMNI_MODEL로 덮어쓸 수 있다 — preview라 이름이 움직인다).
GEMINI_API_KEY=AIza...

# [9] assemble — 언어별 자막 폰트 패밀리. 비우면 subtitle-style.json의 font_name(= ko의 Do Hyeon)으로
# 떨어지고, Do Hyeon은 가나·한자가 없어 ja 자막이 통째로 두부가 된다 — **비워 두지 말 것.**
# 파일은 assets/fonts/에 들어 있고 패밀리 이름은 그 README의 표다.
SUBTITLE_FONT_JA=LINE Seed JP
SUBTITLE_FONT_EN=Google Sans

# [7] motion 차선 — Kling i2v (ADR-0025 §3, MJ 밴 대비).
# 주 경로는 MJ 영상 relax다 (ADR-0039). kling 호출 경로는 미구현.
KLING_API_KEY=

# fal.ai — Veo 3.1 Lite/Fast·Omni Flash 등 영상 모델의 종량 API (2026-08-22 프로브 준비).
# 형식은 `{key_id}:{secret}`. 소비자 코드는 아직 없다 — 2부 시각 경로 교체 ADR 대기.
FAL_KEY=

# [10] upload — 구글 드라이브 (ADR-0084). 조립된 timeline.{lang}.mp4가 여기로 올라간다.
# **셋 다 있어야 [10]이 돈다** — 하나라도 비면 멈춘다 (업로드는 그 단계의 일 전부라
# 조용히 건너뛰지 않는다). 서비스 계정은 못 쓴다: JWT RS256 서명이 필요한데 stdlib에 RSA가
# 없고 이 프로젝트의 의존성은 둘뿐이다 (ADR-0021·0043).
# 값을 받는 법: `python runs/logs/gdrive_oauth.py` — 콘솔에서 만든 **데스크톱 앱** OAuth
# 클라이언트 ID·비밀번호를 넣으면 브라우저 동의 한 번으로 리프레시 토큰을 찍어 준다.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# 선택 — 비우면 내 드라이브 루트에 편 폴더를 만든다. 지정하면 그 폴더 밑에 만든다.
# **앱이 만든 폴더여야 한다** — 스코프가 drive.file이라 사람이 브라우저에서 만든 폴더는
# 404다 (실측 2026-08-31). 만드는 도구: python runs/logs/gdrive_parent_folder.py
# (--adopt를 주면 이미 올라간 편 폴더도 재업로드 없이 그 밑으로 옮긴다)
GDRIVE_PARENT_FOLDER_ID=
